{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "numberOfRuns": 3,
      "url": [
        "http://localhost/index.html",
        "http://localhost/docs/index.html",
        "http://localhost/docs/getting-started/quickstart/index.html",
        "http://localhost/docs/reference/manifest/index.html",
        "http://localhost/docs/cli/project/index.html",
        "http://localhost/docs/cli/project/create/index.html",
        "http://localhost/api/index.html"
      ],
      "settings": {
        "skipAudits": ["is-crawlable"]
      }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", {"minScore": 0.95}],
        "categories:performance": ["error", {"minScore": 0.9}],
        "categories:seo": ["error", {"minScore": 0.9}],
        "categories:best-practices": ["error", {"minScore": 0.9}],
        "csp-xss": "off",
        "installable-manifest": "off",
        "maskable-icon": "off",
        "splash-screen": "off",
        "themed-omnibox": "off",
        "service-worker": "off",
        "apple-touch-icon": "off",
        "pwa-cross-browser": "off",
        "pwa-page-transitions": "off",
        "pwa-each-page-has-url": "off"
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
