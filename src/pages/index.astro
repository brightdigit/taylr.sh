---
import Landing from "../layouts/Landing.astro";
import logo from "../assets/taylr-logo.svg";

const DOCS = "/docs/";
---

<Landing
  title="taylr — a Swift CLI that scaffolds Swift apps"
  description="taylr creates complete, ready-to-ship Swift apps."
>
  <main class="hero">
    <div class="brand">
      <img src={logo.src} alt="" width="48" height="48" />
      <span>taylr</span>
    </div>
    <h1>Scaffold a Swift app that ships from day one.</h1>
    <p>
      taylr is a Swift CLI that creates a complete, ready-to-ship app or Swift package.
    </p>
    <nav>
      <a class="btn btn--primary" href={DOCS}>Read the docs</a>
      <a class="btn" href="/docs/getting-started/quickstart/">Quickstart</a>
    </nav>
    <footer>
      <a href="https://github.com/brightdigit/taylr">Source</a>
      <span aria-hidden="true">·</span>
      <a href="https://github.com/brightdigit/taylr.sh">Website source</a>
    </footer>
  </main>
</Landing>

<style>
  .hero {
    max-width: 40rem;
    min-height: 100vh;
    margin-inline: auto;
    padding: 2rem 1.5rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
  }
  .brand { display: flex; align-items: center; gap: 0.5rem; }
  .brand span {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--taylr-fg);
  }
  h1 {
    font-size: clamp(1.8rem, 5vw, 2.75rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin: 1.5rem 0 1rem;
  }
  p { margin: 0 0 1.75rem; color: var(--taylr-fg-muted); font-size: 1.1rem; }
  nav { display: flex; gap: 0.75rem; flex-wrap: wrap; justify-content: center; }
  .btn {
    padding: 0.7rem 1.35rem;
    border-radius: 0.6rem;
    border: 1px solid var(--taylr-border);
    font-weight: 600;
    text-decoration: none;
  }
  .btn:hover { border-color: var(--taylr-brand-text); color: var(--taylr-brand-text); }
  .btn--primary { background: var(--taylr-brand-fill); border-color: transparent; color: #fff; }
  .btn--primary:hover { background: color-mix(in srgb, var(--taylr-brand-fill) 85%, black); color: #fff; }
  footer {
    margin-top: 2.5rem;
    display: flex;
    gap: 0.5rem;
    font-size: 0.9rem;
    color: var(--taylr-fg-muted);
  }
  footer a { color: inherit; }
  footer a:hover { color: var(--taylr-brand-text); }
</style>
